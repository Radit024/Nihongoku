# NIKU app (Expo)
PORT=18968
BASE_PATH=/

# Used by artifacts/niku/lib/api.ts -> https://<EXPO_PUBLIC_DOMAIN>/api
# Fill with an HTTPS domain only (without protocol), for example: abc123.ngrok-free.app
EXPO_PUBLIC_DOMAIN=your-https-domain.example.com

# Optional explicit API base URL override, for example:
# Android emulator local API: http://10.0.2.2:8080/api
# iOS simulator local API: http://localhost:8080/api
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080/api

